#!/bin/bash
#
# Aggregated test runner for the rohi.network plugin.
# Runs unit, manifest and integration tests, continuing past failures so
# every file gets its runtime coverage.

set -uo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
TEST_DIR="$ROOT/test"

failed=0

run() {
  local label="$1"
  shift
  printf '==> %s\n' "$label"
  if ! "$@"; then
    failed=1
  fi
}

run "Model.js unit tests (node)" node "$TEST_DIR/model.test.js"
run "settings.py validation tests" python3 "$TEST_DIR/settings.test.py"
run "Manifest and shell contract" python3 "$TEST_DIR/manifest.test.py"
run "Integration against NetworkManager" node "$TEST_DIR/integration.test.js"

if [[ $failed -ne 0 ]]; then
  printf '\nSome tests failed.\n' >&2
  exit 1
fi

printf '\nAll tests passed.\n'
